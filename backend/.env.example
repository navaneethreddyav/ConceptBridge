# Required: Google Gemini Developer API key. Server-side only, never exposed to the frontend.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.6-flash). Tried first,
# before the free-tier fallback waterfall below.
GEMINI_MODEL=

# Optional: comma-separated free-tier model fallback list. When the current model's
# daily free-tier quota is exhausted, the next one in this list is tried automatically
# (never a paid model, never a billing change). Defaults to a built-in list if unset —
# see modelManager.js. Update if Google renames/retires a free-tier model.
GEMINI_MODEL_CANDIDATES=

# Required: YouTube Data API v3 key. Server-side only, never exposed to the frontend.
YOUTUBE_API_KEY=

# Optional: port the API listens on (defaults to 3001).
PORT=3001

# Optional: set to "production" when deploying. Suppresses stack-trace logging and
# strips error details from API responses. Leave unset/"development" locally.
NODE_ENV=

# Optional: local Ollama fallback used during development only. Not required in production.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
