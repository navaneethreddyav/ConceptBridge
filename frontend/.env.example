# Base URL of the ConceptBridge backend API (Cloudflare Worker). Defaults to
# http://localhost:8787 in local dev (wrangler dev's default port, see backend's
# `npm run cf:dev`). In production, set this to the deployed Worker URL, e.g.
# https://conceptbridge-api.<your-subdomain>.workers.dev — frontend and backend are
# always separate origins post-migration, there is no same-origin fallback.
# Must be set at BUILD time — Vite inlines it into the bundle, so rebuild after changing it.
# Only VITE_-prefixed vars reach the frontend; never put an API key here.
VITE_API_BASE_URL=http://localhost:8787
